{
  "name": "deskbook-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "build": "node scripts/copy-pyodide.mjs && vite build && node scripts/check-offline.mjs",
    "check-offline": "node scripts/check-offline.mjs",
    "test:py": "cd src/python && python3 -m unittest discover -s tests -v"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "pyodide": "0.26.4",
    "tailwindcss": "3.4.14",
    "vite": "5.4.10"
  }
}
